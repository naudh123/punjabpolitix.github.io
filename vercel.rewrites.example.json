{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_ADMIN_API_HOST/api/:path*"
    },
    { "source": "/health", "destination": "https://YOUR_ADMIN_API_HOST/health" },
    { "source": "/openapi.json", "destination": "https://YOUR_ADMIN_API_HOST/openapi.json" },
    { "source": "/docs", "destination": "https://YOUR_ADMIN_API_HOST/docs" },
    { "source": "/docs/:path*", "destination": "https://YOUR_ADMIN_API_HOST/docs/:path*" }
  ],
  "headers": [
    {
      "source": "/rajneetios/Admin/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
